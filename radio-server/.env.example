# Copy to .env.local and fill in. Never commit .env.local.
PORT=8080
PUBLIC_URL=https://radio-api.dogs.red
ALLOWED_ORIGIN=https://radio.dogs.red
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
YOUTUBE_API_KEY=
# Auto-DJ: comma-separated Spotify playlist IDs to shuffle when he's not
# actively playing. Find a playlist's ID in its Spotify share URL.
AUTODJ_PLAYLISTS=
# Seconds of Spotify silence before the DJ takes over (min 10).
AUTODJ_IDLE_SECS=120
# Playlist converter: Google OAuth client (needs the YouTube Data API
# enabled + youtube.force-ssl scope on the consent screen).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=<redacted>
# Optional: HMAC secret for converter session cookies. Random per boot
# if empty (visitors just re-connect after a restart).
CONVERT_SESSION_SECRET=
